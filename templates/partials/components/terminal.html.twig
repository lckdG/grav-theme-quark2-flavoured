{% set term_pages = {} %}
{% for item in pages.children.visible %}
    {% set term_pages = term_pages|merge({(item.slug): item.url}) %}
{% endfor %}
{% set term_allowed = {} %}
{% for item in terminal.pages|default([{slug: 'portfolio', color: 't-green'}, {slug: 'blog', color: 't-blue'}]) %}
    {% set term_allowed = term_allowed|merge({(item.slug): item.color}) %}
{% endfor %}
<div class="terminal" data-pages="{{ term_pages|json_encode|e('html_attr') }}" data-not-found="{{ 'THEME_QUARK2.TERMINAL.NOT_FOUND'|t|e('html_attr') }}" data-no-page="{{ 'THEME_QUARK2.TERMINAL.NO_PAGE'|t|e('html_attr') }}" data-whoami="{{ terminal.whoami|e('html_attr') }}" data-allowed="{{ term_allowed|json_encode|e('html_attr') }}"{% if terminal.commands %} data-commands="{{ terminal.commands|json_encode|e('html_attr') }}"{% endif %}>
    <div class="term-bar" aria-hidden="true">
        <span class="seg seg-profile"><b><i class="nf nf-md-card_multiple"></i></b> {{ terminal.profile|default('default') }}</span>
        {% if terminal.cwd %}<span class="seg seg-cwd"><b><i class="nf nf-md-folder_open"></i></b> {{ terminal.cwd }}</span>{% endif %}
        <span class="term-tabs">
            {% for tab in terminal.tabs|default(['zsh']) %}
                <span class="term-tab{{ loop.first ? ' is-active' }}">{{ loop.index }}: {{ tab }}</span>
            {% endfor %}
        </span>
        {% if terminal.branch %}
            <span class="seg seg-git"><b><i class="nf nf-dev-git"></i></b> {{ terminal.branch }} <i class="t-git t-git-add"><i class="nf nf-cod-diff_added"></i>4</i> <i class="t-git t-git-mod"><i class="nf nf-cod-diff_modified"></i>7</i> <i class="t-git t-git-del"><i class="nf nf-cod-diff_removed"></i>3</i></span>
        {% endif %}
        <span class="seg seg-clock"><b><i class="nf nf-fa-clock_o"></i></b> {{ "now"|date("H:i") }}</span>
    </div>

    <div class="term-body">
        <p class="term-input"><span class="term-prompt">❯</span> <input class="term-field" type="text" aria-label="{{ 'THEME_QUARK2.TERMINAL.INPUT'|t|e('html_attr') }}" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" disabled><span class="term-cursor" aria-hidden="true">▍</span></p>
    </div>
</div>
