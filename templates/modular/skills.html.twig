<section class="section modular-features skills">
    <div class="container">
        <div class="frame-box">
            {{ content|raw }}

            <div class="columns">
            {% for skill in page.header.skills %}
                <div class="column">
                    <div class="feature-icon">
                        {% if skill.image %}{{ page.media[skill.image] | raw }}{% endif %}
                        {% if skill.header %}<h6>{{ skill.header }}</h6>{% endif %}
                    </div>
                </div>
            {% endfor %}
            </div>
        </div>
    </div>
</section>
