<section class="section modular-features skills {{ page.header.section_class }}">
    <div class="container">
        <div class="frame-box">
            {{ content|raw }}

            <div class="categories">
            {% for category in page.header.categories %}
              <div class="category">
                <h4>{{ category.title }}</h4>
                <div class="columns">
                {% for skill in category.skills %}
                    <div class="column">
                        <div class="feature-icon">
                            {% if skill.image %}{{ page.media[skill.image] | raw }}{% endif %}
                            {% if skill.header %}<h6>{{ skill.header }}</h6>{% endif %}
                        </div>
                    </div>
                {% endfor %}
                </div>
              </div>
            {% endfor %}
            </div>
        </div>
    </div>
</section>
