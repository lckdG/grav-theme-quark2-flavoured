<section class="section skills {{ page.header.section_class }}">
    <div class="container">
        <header class="section-head">
            <div class="section-intro">{{ content|raw }}</div>
        </header>

        {% if page.header.categories %}
            <div class="skill-groups">
                {% for category in page.header.categories %}
                    <div class="glass-card skill-group rarity-{{ category.rarity|default('common') }}">
                        <h3 class="skill-group-title">{{ category.title }}</h3>
                        <ul class="skill-list">
                            {% for skill in category.skills %}
                                {% set icon = skill.image ? page.media[skill.image] : null %}
                                <li class="skill" title="{{ skill.header }}">
                                    <span class="icon-tile">{% if icon %}{{ icon.html('', '')|raw }}{% endif %}</span>
                                    <span class="skill-name">{{ skill.header }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
