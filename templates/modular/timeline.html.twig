<section class="section">
    <div class="container">
        {{ content|raw }}

        <div class="timeline">
        {% for item in page.header.timeline %}
            <div class="timeline-container">
                <div class="timeline-icon">
                    <i class="fa-regular fa-dot"></i>
                </div>
                <div class="timeline-body">
                    <span class="timeline-right">{{ item.startdate }}{% if item.present %} - Present{% else %} - {{ item.enddate }}{% endif %}</span>
                    <h4 class="timeline-title">{{ item.header }}</h4>
                    {% if item.subheader %}
                        <h5 class="timeline-subtitle">{{ item.subheader }}</h5>
                    {% endif %}
                    {% if item.description %}
                        <p>{{ item.description }}</p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</section>
