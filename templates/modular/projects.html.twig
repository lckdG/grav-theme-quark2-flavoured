<section class="section modular-features {{ page.header.class }}">
    <div class="container">
        <div class="frame-box">
            {{ content|raw }}

            <div class="columns">
            {% for project in page.header.projects %}
                <div class="column">
                    {% if project.url %}<a href="{{ project.url }}" style="text-decoration:none;color:inherit;display:block;">{% endif %}
                    <div class="feature-icon">
                        {% if project.image %} {{ page.media[project.image]|raw}} {% endif %}
                        {% if project.header %}<h6>{{ project.header }}</h6>{% endif %}
                    </div>
                    <div class="feature-content">
                        {% if project.text %}<p>{{ project.text }}</p>{% endif %}
                        {% if project.role %}<strong>Role:</strong> {{ project.role }} {% endif %}
                        <br>
                        {% for tag in project.tags %}
                            <div class="chip">
                                {{ page.media[tag.image].html('', '', 'avatar avatar-sm')|raw }}
                                {{ tag.title|raw }}
                            </div>
                        {% endfor %}
                    </div>
                    {% if projects.url %}</a>{% endif %}
                </div>
            {% endfor %}
            </div>
        </div>
    </div>
</section>
